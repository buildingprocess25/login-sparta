    {
      "id": "docs_superpowers_plans_2026_06_17_sparta_backend_monorepo_spec_branch_default_password",
      "label": "Branch-name uppercase default password (BRANCH_DEFAULT)",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/2026-06-17-sparta-backend-monorepo-spec.md",
      "source_location": "L46",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Branch password is never stored, derived from branch name while passwordState=BRANCH_DEFAULT; mustChangePassword forces a new Argon2id-hashed password before module access."
    },
    {
      "id": "docs_superpowers_plans_2026_06_17_sparta_backend_monorepo_spec_server_side_session",
      "label": "Server-side session with HttpOnly cookie",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/2026-06-17-sparta-backend-monorepo-spec.md",
      "source_location": "L1006",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Server-side sessions in PostgreSQL are easier to revoke than JWTs; token stored as sha256(raw+SESSION_SECRET); no localStorage auth."
    },
    {
      "id": "docs_superpowers_plans_2026_06_17_sparta_backend_monorepo_spec_otp_password_recovery",
      "label": "OTP password recovery and change (HMAC-hashed OTP)",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/2026-06-17-sparta-backend-monorepo-spec.md",
      "source_location": "L53",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "OTP never stored plain text: codeHash = HMAC_SHA256(OTP_PEPPER, email:purpose:otp), with expiry and attempt limits."
    },
    {
      "id": "docs_superpowers_plans_2026_06_17_sparta_backend_monorepo_spec_cookie_strategy",
